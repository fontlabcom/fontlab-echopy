src = fl.CurrentFont()

# Collect stem data:
v_stems = [(s.name, s.value) for s in src.ps_stemsV]
h_stems = [(s.name, s.value) for s in src.ps_stemsH]
print("V-stems:", v_stems)
print("H-stems:", h_stems)

# To apply to another font:
# for name, value in v_stems:
#     s = flStem(); s.name = name; s.value = value
#     dst.ps_stemsV.append(s)
